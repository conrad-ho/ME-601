function ref_to = make_straight_ref(tspan, y0, opts)
% make_straight_ref
% generates a simple s-arc hitch reference path:
% turn left for a fixed angle, then turn right for the same angle.
%
% inputs:
%   tspan : 1x(N+1) or (N+1)x1 time grid (assumed uniform)
%   y0    : 2x1 initial hitch position [xh0; yh0]
%   opts  : options
%       opts.R      : turn radius (default 2.0)
%       opts.w      : yaw rate magnitude (default 0.3 rad/s)
%       opts.angle  : sweep angle per segment (default pi/2)
%       opts.theta0 : initial heading (default 0)
%
% outputs (hitch-only ref for TO):
%   ref_to.t       : 1xN time
%   ref_to.p_h     : 2xN hitch position
%   ref_to.p_hitch : 2xN hitch position (alias for compatibility)
%   ref_to.pdot_h  : 2xN hitch velocity (finite-diff)
%   ref_to.pddot_h : 2xN hitch acceleration (finite-diff)
%   ref_to.theta_h : 1xN hitch tangent heading (unwrap)

    if nargin < 3, opts = struct(); end
    if nargin < 2 || isempty(y0), y0 = [0;0]; end

    if ~isfield(opts,'R'),      opts.R      = 10.0;     end
    if ~isfield(opts,'w'),      opts.w      = 0.3;     end
    if ~isfield(opts,'angle'),  opts.angle  = pi/2;    end
    if ~isfield(opts,'theta0'), opts.theta0 = 0.0;     end

    R      = opts.R;
    w      = opts.w;
    angle  = opts.angle;
    theta0 = opts.theta0;

    % speed v = R*|w| so curvature is 1/R during turns
    v = R * abs(w);

    % segment durations
    T1 = angle / max(abs(w), eps);
    T2 = 2*T1;

    % time grid (assume uniform)
    tspan = tspan(:).';
    Nt = numel(tspan);
    if Nt < 2
        error('tspan must have at least 2 points');
    end
    dt = tspan(2) - tspan(1);

    % integrate hitch position p_h and heading theta (used only to integrate position)
    p_h   = zeros(2, Nt);
    theta = zeros(1, Nt);

    p_h(:,1) = y0(:);
    theta(1) = theta0;

    for k = 2:Nt
        t_prev = tspan(k-1);
        th     = theta(k-1);

        % piecewise yaw rate
        if t_prev <= T1
            w_k = sign(w) * abs(w);      % left
        elseif t_prev <= T2
            w_k = -sign(w) * abs(w);     % right
        else
            w_k = 0;                     % straight
        end

        % integrate heading
        theta(k) = th + w_k * dt;

        % integrate position using previous heading
        p_h(:,k) = p_h(:,k-1) + v * [cos(th); sin(th)] * dt;
    end

    % finite-diff derivatives
    pdot_h  = [gradient(p_h(1,:), dt);  gradient(p_h(2,:), dt)];
    pddot_h = [gradient(pdot_h(1,:), dt); gradient(pdot_h(2,:), dt)];

    % hitch tangent heading (use velocity direction; fallback to integrated theta if needed)
    speed = sqrt(pdot_h(1,:).^2 + pdot_h(2,:).^2);
    theta_h = atan2(pdot_h(2,:), pdot_h(1,:));
    theta_h = unwrap(theta_h);

    % if speed is ~0 at some points, theta_h can be noisy; fall back to integrated theta there
    bad = speed < 1e-9;
    if any(bad)
        theta_int = unwrap(theta);
        theta_h(bad) = theta_int(bad);
    end

    % pack output
    ref_to = struct();
    ref_to.t       = tspan;
    ref_to.p_h     = p_h;
    ref_to.p_hitch = p_h;        % compatibility alias

    ref_to.pdot_h  = pdot_h;
    ref_to.pddot_h = pddot_h;
    ref_to.theta_h = theta_h;
end
